# TallyVis is Korr's AI-powered estimator (see src/tallyvis-embed.ts).
#
# TallyVis embeds via a script tag that mounts itself into the
# #tallyvis-estimator container, configured with a data-tallyvis-id
# attribute. Set both values below to enable it; leave either blank and the
# site shows a graceful "coming soon" placeholder instead.
#
# VITE_TALLYVIS_SCRIPT_URL currently points at a local TallyVis dev server
# (http://localhost:3001/embed.js) and must be updated to TallyVis's
# production embed script URL before this site is deployed live.
#
# These are build-time, public values (Vite exposes anything prefixed with
# VITE_ to the client) — do not put secrets here.
VITE_TALLYVIS_SCRIPT_URL=
VITE_TALLYVIS_ESTIMATOR_ID=
